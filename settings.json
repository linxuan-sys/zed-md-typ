// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "lsp_document_colors": "border",
  "cursor_animation": {
    "enabled": true
  },
  "language_models": {
    "opencode": {
      "show_go_models": false
    }
  },
  "proxy": "",
  "minimum_split_diff_width": 100.0,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "agent_ui_font_family": "JetBrainsMono Nerd Font",
  "cli_default_open_behavior": "existing_window",
  "markdown_preview": {
    "max_width": 900.0,
    "font_size": 16.5
  },
  "agent_buffer_font_size": 15.5,
  "agent_ui_font_size": 17.0,
  "vim": {
    "use_system_clipboard": "always"
  },
  "vim_mode": false,
  "base_keymap": "VSCode",
  "agent": {
    "max_content_width": 850.0,
    "default_model": {
      "effort": "low",
      "provider": "deepseek",
      "model": "deepseek-flash",
      "enable_thinking": true
    },
    "favorite_models": [
      {
        "provider": "deepseek",
        "model": "deepseek-flash",
        "enable_thinking": true,
        "effort": "low"
      }
    ],
    "model_parameters": []
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "model": "opencode/ling-3.0-flash-fin-free"
      },
      "type": "registry"
    }
  },
  "edit_predictions": {
    "mode": "eager",
    "provider": "copilot"
  },
  "terminal": {
    "font_size": 16.0
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 16.5,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Espresso (Blur) [Light]",
  },
}
